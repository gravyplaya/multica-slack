# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output ---
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Test / coverage output ---
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/

# --- Local environment files (NEVER commit secrets) ---
.env
.env.*
!.env.example
.env*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE / editor ---
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# --- OS / runtime artefacts ---
.pid
*.pid
.tmp/
tmp/

# --- Multica runtime context (per-run agent/issue IDs; never track) ---
# The .multica/ tree is generated locally by the Multica runtime and may
# contain daemon task context, project resource pointers, and other
# workspace-private data. None of it is intended for source control.
.multica/
.agent_context/

# --- Misc ---
.cache/
.parcel-cache/
.vercel