{
  "name": "multica-slack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "smoke:ws": "node scripts/ws-smoke.mjs",
    "verify": "pnpm run validate:fixtures && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.16",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
