# Multica Slack Interface — environment variables (NO SECRETS).
# Copy this file to `.env.local` and fill in real values for your setup.
# Do NOT check `.env.local` into git; the gitignore covers it.

# Multica REST API base URL (no trailing slash).
# Default assumes a local self-hosted Multica started via `make selfhost` in
# the sibling `multica` checkout, which listens on port 8080.
NEXT_PUBLIC_MULTICA_API=http://localhost:8080

# Multica WebSocket endpoint.
# Path is fixed at `/ws`; the host must match the REST API host (see
# docs/contracts/multica-api.md for the handshake details).
NEXT_PUBLIC_MULTICA_WS=ws://localhost:8080/ws

# Optional: name shown in the workspace chrome. No logo until Stage 3 picks
# the visual direction; keep this short.
NEXT_PUBLIC_APP_NAME="Multica Slack"